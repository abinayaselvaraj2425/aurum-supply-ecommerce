/next.config.ts
/postcss.config.mjs
/tsconfig.json
/vite.config.ts
/package-lock.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/.npmrc
/scripts/build-verified.sh
/scripts/build.sh
